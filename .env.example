# Only required when confirming publication (do not commit the real value)
CONTENT_PUBLISH_PASSWORD=change-this-publish-password

# Local prototype storage. The production adapter will use PostgreSQL later.
CONTENT_ADMIN_STORAGE=local

# Vercel/Neon: set CONTENT_ADMIN_STORAGE=postgres and provide either variable.
# DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# Existing public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional free AI draft preview. Use a Google AI Studio Free tier project without billing.
# Never use NEXT_PUBLIC_ for API keys. GOOGLE_API_KEY is also accepted for existing installs.
# GEMINI_API_KEY=

# Existing LINE login integration (required only if LINE login is enabled)
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
